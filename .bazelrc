# Compatible CPU configuration for the pinned XLA; no GPU backend enabled.
common --enable_bzlmod --noenable_workspace
common --experimental_repo_remote_exec
common --incompatible_default_to_explicit_init_py
common --incompatible_disallow_empty_glob=false
common --legacy_external_runfiles=true
common --incompatible_enable_cc_toolchain_resolution
common --repo_env=USE_HERMETIC_CC_TOOLCHAIN=1
common --repo_env=USE_PYWRAP_RULES=True
common --repo_env=PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=upb
common --repo_env=RULES_PYTHON_ENABLE_PIPSTAR=0
common --@rules_python//python/config_settings:precompile=force_disabled
common --@rules_python//python/config_settings:bootstrap_impl=script
build -c opt
build --define=framework_shared_object=true
build --define=tsl_protobuf_header_only=true
build --define=allow_oversize_protos=true
build --define=grpc_no_ares=true
build --copt=-DGRPC_BAZEL_BUILD
build --host_copt=-DGRPC_BAZEL_BUILD
build --action_env=GRPC_BAZEL_RUNTIME=1
build --action_env=PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=upb
build --noincompatible_remove_legacy_whole_archive
build --experimental_cc_shared_library
build --experimental_link_static_libraries_once=false
build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17
build --copt=-Wno-sign-compare
build --copt=-Wno-error=unused-command-line-argument
build --copt=-Wno-gnu-offsetof-extensions
build --build_tag_filters=-no_oss,-gpu
test --test_tag_filters=-no_oss,-gpu
test --test_output=errors

# Optional private credentials, cache endpoints, and machine resource limits.
try-import %workspace%/.bazelrc.local
