0: { %s_seed = smov 0 }
1 LB: { %s_i = sphi %s_seed, %s_next } /* Start region 1 */
2: { %v0 = vadd.f32 %input0, 1.0 ;; %v1 = vadd.f32 %input1, 2.0 }
3: { %m0 = vmatmul.mubr.bf16.mrb[0].mxu0 %v0 ;; %m1 = vmatmul.mubr.bf16.mrb[0].mxu1 %v1 }
4: { %r0 = vpop.f32.mrb[0].mxu0 ;; %r1 = vpop.f32.mrb[0].mxu1 }
5: { %r2 = vpop.f32.mrb[1].mxu0 ;; %r3 = vpop.f32.mrb[1].mxu1 }
6: { %r4 = vpop.f32.mrb[2].mxu0 ;; %r5 = vpop.f32.mrb[2].mxu1 }
7: { %r6 = vpop.f32.mrb[3].mxu0 ;; %r7 = vpop.f32.mrb[3].mxu1 }
8: { %v2 = vadd.f32 %r0, %r1 }
9: { %s_next = sadd.s32 %s_i, 1 }
10: { %p_more = scmp.lt.s32.totalorder %s_next, 2 }
11: { sbr.rel (%p_more) target = $region1 }
12: { %v_out = vadd.f32 %v2, 1.0 }
