#!/usr/bin/env bash
# Keep upstream XLA's root-module overrides and toolchain configuration intact.
set -euo pipefail
sim_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
"${SIM_BOOTSTRAP_PYTHON:-python3}" "$sim_root/scripts/prepare.py" >/dev/null
cd "$sim_root/.build/xla"
exec "${BAZEL:-bazel}" "$@"
