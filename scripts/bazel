#!/usr/bin/env bash
# Keep upstream XLA's root-module overrides and toolchain configuration intact.
set -euo pipefail
sim_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
"${SIM_BOOTSTRAP_PYTHON:-python3}" "$sim_root/scripts/prepare.py" >/dev/null
cd "$sim_root/.build/xla"
sim_startup=()
if [[ ${SIM_BAZEL_BATCH:-0} == 1 ]]; then
  sim_startup+=(--batch)
fi
if [[ -n ${SIM_BAZEL_OUTPUT_ROOT:-} ]]; then
  sim_startup+=("--output_user_root=$SIM_BAZEL_OUTPUT_ROOT")
fi
exec "${BAZEL:-bazel}" "${sim_startup[@]}" "$@"
